{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "front_client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "front_client",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set DEBUG=True&& set PYTHONIOENCODING=utf-8&& backend\\.venv\\Scripts\\python.exe backend\\manage.py runserver 8000"
      ],
      "port": 8000
    },
    {
      "name": "mobile_owner_web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "mobile_owner\\gradlew.bat -p mobile_owner wasmJsBrowserDevelopmentRun --console=plain"
      ],
      "port": 8080
    },
    {
      "name": "backend_admin",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set DEBUG=True&& set PYTHONIOENCODING=utf-8&& backend\\.venv\\Scripts\\python.exe backend\\manage.py runserver 8010"
      ],
      "port": 8010
    },
    {
      "name": "backend_mac",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd backend && DEBUG=True .venv/bin/python manage.py runserver 8000"
      ],
      "port": 8000
    },
    {
      "name": "backend_mobile_client_mac",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd ../Noobatyar-mobile-client/backend && ../../Noobatyar-automation/backend/.venv/bin/python manage.py runserver 8000"
      ],
      "port": 8000
    },
    {
      "name": "mobile_owner_web_mac",
      "runtimeExecutable": "/Applications/Android Studio.app/Contents/jbr/Contents/Home/bin/java",
      "runtimeArgs": [
        "-classpath",
        "mobile_owner/gradle/wrapper/gradle-wrapper.jar",
        "org.gradle.wrapper.GradleWrapperMain",
        "-p",
        "mobile_owner",
        "wasmJsBrowserDevelopmentRun",
        "--console=plain"
      ],
      "port": 8080
    },
    {
      "name": "front_client_mobile_mac",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd ../Noobatyar-mobile-client/front_client && npm run dev -- -p 3010"
      ],
      "port": 3010
    }
  ]
}